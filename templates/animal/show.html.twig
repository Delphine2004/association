{% extends 'base.html.twig' %}
{% block title %}Animal - Informations{%
endblock%}
{% block body %}

	<main class="pt-5">
		<section id="animal-page" class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card shadow-sm">
							<div class="card-header py-3">
								<h1>Animal n°{{ animal.id }}</h1>
							</div>
							<div
								class="card-body">
								<!-- Photo -->
								<div class="image-wrapper mx-auto mb-4">
									<img src="{{ asset('uploads/animals/' ~ animal.picture) }}" alt="{{ animal.name }}" class="img-fluid rounded-4"/>
								</div>

								<!-- ID, Nom et statut -->
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>
											Ref :</strong>
										<span>{{ animal.id }}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>
											Nom :</strong>
										<span>{{ animal.name }}</span>
									</div>
									{% if is_granted('ROLE_EMPLOYE') %}
										<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
											<strong>
												Statut:</strong>
											<span>{{ animal.status.value }}</span>
										</div>
									{% endif %}
								</div>

								<!-- Type / Race / Genre -->
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Type</strong>
										<span>{{ animal.type.value }}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Race</strong>
										<span>{{ animal.race.value }}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Genre</strong>
										<span>{{ animal.gender.value }}</span>
									</div>
								</div>

								<!-- Médical -->
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Vacciné(e)</strong>
										<span>{{animal.vaccinated ? "Oui" : "Non"}}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Sterilisé(e)</strong>
										<span>{{animal.sterilized ? "Oui" : "Non"}}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Pucé(e)</strong>
										<span>{{animal.chipped ? "Oui" : "Non"}}</span>
									</div>
								</div>

								<!-- Comportement -->
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Compatible enfant</strong>
										<span>{{animal.compatibleKid ? "Oui" : "Non"}}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Compatible chat</strong>
										<span>{{animal.compatibleCat ? "Oui" : "Non"}}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Compatible chien</strong>
										<span>{{animal.compatibleDog ? "Oui" : "Non"}}</span>
									</div>
								</div>

								<!-- Dates -->
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Date de naissance</strong>
										<span>{{ animal.birthday ? animal.birthday|date('d/m/Y') : '' }}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Date d'arrivée</strong>
										<span>{{ animal.arrivalDate ? animal.arrivalDate|date('d/m/Y') : '' }}</span>
									</div>
								</div>

								<!-- Description -->
								<div class="d-flex flex-column py-2 mb-3 border-bottom">
									<strong>Description</strong>
									<p>{{ animal.description }}</p>
								</div>

								<!-- Création et modification -->
								<div class="py-2 mb-3">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Création :
										</strong>
										<span>{{ animal.createdAt ? animal.createdAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Modification :
										</strong>
										<span>{{animal.updatedAt ? animal.updatedAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>
								</div>
							</div>

							{% set STATUS_A_ADOPTER = 'A adopter' %}
							{% set STATUS_EN_SOIN = 'En soin' %}

							<div class="card-footer py-5">
								<div class="row justify-content-evenly g-3">
									{% for label, messages in app.flashes %}
										<div class="col-12 col-md-10">
											{% for message in messages %}
												<p class=" fw-bold text-center m-3 alert alert-{{ label }}">
													{{ message }}
												</p>
											{% endfor %}
										</div>
									{% endfor %}

									{% if is_granted('ROLE_EMPLOYE') %}

										{% if animal.status.value in [STATUS_EN_SOIN, STATUS_A_ADOPTER] %}
											<div class="col-12 col-md-4">
												<a class="btn w-100" href="{{ path('app_animal_edit', { id: animal.id }) }}">
													Modifier
												</a>
											</div>

											<div class="col-12 col-md-4">
												<div class="flex-fill">
													{{include("animal/_delete_form.html.twig")}}
												</div>
											</div>
										{% endif %}

										{% if animal.status.value == STATUS_A_ADOPTER %}
											<div class="col-12 col-md-4">
												<div class="flex-fill">
													{{include("animal/_adopted_form.html.twig")}}
												</div>
											</div>
										{% endif %}

									{% endif %}
								</div>
							</div>

						</div>

					</div>

					<div class="col-12 col-md-10 col-lg-8">
						{% if is_granted('ROLE_EMPLOYE') %}
							<div class="text-center m-5">
								<a class="btn" href="{{ path('app_animal_page') }}">
									Revenir aux animaux
								</a>
							</div>

						{% else %}
							<div class="text-center m-5">
								<a class="btn" href="{{ path('adoption') }}">
									Revenir aux animaux
								</a>
							</div>
						{% endif %}
					</div>
				</div>

			</div>
		</section>
	</main>

{% endblock %}
