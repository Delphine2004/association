{% extends 'base.html.twig' %}
{% block title %}Animal - Modification
{% endblock
%}
{% block body %}

	<main class="pt-5">
		<section id="animal-page" class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card card-form shadow-sm d-flex justify-content-evenly p-4">
							<h1 class="text-center m-3">Modification de l'animal</h1>
							{{ include("animal/_form.html.twig", { button_label: "Modifier" }) }}
						</div>
					</div>

					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-5">
							<a class="btn" href="{{ path('app_animal_show', { id: animal.id }) }}">Revenir à l'animal</a>
						</div>
					</div>
          
				</div>
			</div>
		</section>
	</main>
{% endblock %}
