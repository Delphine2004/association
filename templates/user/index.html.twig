{% extends 'base.html.twig' %}
{% block title %}Espace utilisateur
{% endblock %}
{% block body %}
	<main class="pt-5">
		<section class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<h1 class="text-center m-3">Tableau de bord</h1>
					</div>
				</div>
			</div>
		</section>

		<section class="container-fluid mb-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm">
							<div class="card-header py-3">
								<h2 class="text-center m-3">Animaux à examiner</h2>
							</div>

							<div class="card-body p-0">
								{% if animals|length > 0 %}
									{% for animal in animals %}

										<div class="card flex-md-row justify-content-center align-items-center shadow-sm m-3">
											<div class="row justify-content-center align-items-center w-100 g-3">

												<div class="col-12 col-md-9">
													<div class="d-flex flex-column flex-md-row justify-content-between ">
														<div class="d-flex flex-column flex-md-row justify-content-between">
															<p class="fw-bold text-center text-md-start my-3">{{ animal.name }}</p>
														</div>
														<div class="d-flex flex-row justify-content-around gap-3">
															<p class="text-center text-md-start my-3">{{ animal.type.value }}</p>
															<p class="text-center text-md-start my-3">
																{{animal.gender.value }}</p>
														</div>
													</div>
												</div>

												<div class="col-12 col-md-2 text-center">
													<a class="btn w-100" target="_blank" href="{{ path('app_animal_edit', { id: animal.id }) }}">Voir</a>
												</div>
											</div>
										</div>

									{% endfor %}
								{% else %}
									<p class="text-center m-2">Aucun animal à examiner.</p>
								{% endif %}
							</div>

						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="container-fluid mb-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card shadow-sm">
							<div class="card-header py-3">
								<h2 class="text-center m-3">Evénement à venir</h2>
							</div>

							<div class="card-body p-0">
								{% if events|length > 0 %}
									{% for event in events %}
										<div class="card flex-md-row justify-content-center align-items-center shadow-sm m-3">
											<div class="row justify-content-center align-items-center w-100 g-3">

												<div class="col-12 col-md-9">
													<div class="d-flex flex-row justify-content-center">
														<p class="fw-bold text-center text-md-start my-3">
															{{ event.date ? event.date|date('d/m/Y') : '' }}
														</p>
													</div>
													<div class="d-flex flex-row justify-content-center">
														<p class="text-center text-md-start my-3">{{ event.place }}</p>
													</div>
												</div>

												<div class="col-12 col-md-2 text-center">
													<a class="btn w-100" target="_blank" href="{{ path('app_event_edit', { id: event.id }) }}">
														Voir
													</a>
												</div>
											</div>
										</div>
									{% endfor %}
								{% else %}
									<p class="text-center m-2">Aucun événement à venir.</p>
								{% endif %}
							</div>
						</div>

					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
