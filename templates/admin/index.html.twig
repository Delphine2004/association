{% extends 'base.html.twig' %}
{% block title %}Espace Admin
{% endblock %}
{%
block body %}

	<main class="pt-5">
		<section class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center align-items-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card shadow-sm">
							<div class="card-header py-3">
								<h2 class="text-center m-3">
									Gestion des utilisateurs
								</h2>
							</div>

							<div class="card-body p-0">
								{% if users|length > 0 %}
									{% for user in users %}
										<div class="card flex-md-row justify-content-center align-items-center shadow-sm m-3">
											<div class="row justify-content-center align-items-center w-100 g-3">

												<div class="col-12 col-md-9">
													<div class="d-flex flex-row justify-content-between p-3">
														<p class="text-center text-md-start my-3">{{ user.email }}</p>
														<p class="fw-bold text-center text-md-start my-3">
															{% set rolesList = [] %}
															{% for role in user.roles %}
																{% if role != 'ROLE_USER' %}
																	{% set rolesList = rolesList|merge([role|replace({'ROLE_': ''})]) %}
																{% endif %}
															{% endfor %}
															{{ rolesList|join(', ') }}
														</p>
													</div>
												</div>

												<div class="col-12 col-md-2 text-center p-3">
													<a class="btn w-100" href="{{ path('app_user_show', { id: user.id }) }}">Voir</a>
												</div>
											</div>
										</div>
									{% endfor %}
								{% else %}
									<p class="text-center m-2">Aucun utilisateur trouvé.</p>
								{% endif %}
							</div>

							<div class="card-footer">
								<div class="row justify-content-center m-3">
									<div class="col-12 col-md-6">
										<a class="btn w-100" href="{{ path('app_user_new') }}">Ajouter un utilisateur</a>
									</div>
								</div>
							</div>
						</div>

					</div>
				</div>
			</section>
		</main>
	{% endblock %}
