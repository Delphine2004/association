{% extends 'base.html.twig' %}
{% block title %}Evénement - Modification
{%
endblock %}
{% block body %}

	<main class="pt-5">
		<section id="event-page" class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card card-form shadow-sm d-flex justify-content-evenly p-4">
							<h1 class="text-center m-3">Modification de l'événement</h1>
							{{ include("event/_form.html.twig", {button_label: "Modifier"})}}
						</div>
					</div>

					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-5">
							<a class="btn" href="{{ path('app_event_show', { id: event.id }) }}">Revenir à l'événement</a>
						</div>
					</div>
          
				</div>
			</div>
		</section>
	</main>
{% endblock %}
