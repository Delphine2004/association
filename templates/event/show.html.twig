{% extends 'base.html.twig' %}
{% block title %}Evénement - Informations
{%
endblock %}
{% block body %}

	<main class="pt-5">
		<section id="event-page" class="container-fluid py-5">
			<div class="container">

				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">

						<div class="card shadow-sm">
							<div class="card-header py-3">
								<h2>Evénement n°{{ event.id }}</h2>
							</div>
							<div
								class="card-body">
								<!-- Photo -->
								<div class="image-wrapper mx-auto mb-4">
									<img src="{{ asset('uploads/events/' ~ event.picture) }}" alt="événement n°{{ event.id }}" class="img-fluid rounded-4"/>
								</div>

								<!-- Date et lieu -->
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Date :</strong>
										<span>{{ event.date ? event.date|date('d/m/Y') : '' }}</span>
									</div>

									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Lieu :</strong>
										<span>{{ event.place }}</span>
									</div>
								</div>

								<!-- Description -->
								<div class="d-flex flex-column py-2 mb-3 border-bottom">
									<strong>Description :</strong>
									<p>{{ event.description }}</p>
								</div>

								<!-- Création et modification -->
								<div class="py-2 mb-3">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Création :
										</strong>
										<span>{{ event.createdAt ? event.createdAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>

									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Modification :
										</strong>
										<span>{{ event.updatedAt ? event.updatedAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>
								</div>
							</div>

							<div class="card-footer py-5">
								<div class="row justify-content-evenly g-3">
									{% for label, messages in app.flashes %}
										<div class="col-12 col-md-10">
											{% for message in messages %}
												<p class=" fw-bold text-center m-3 alert alert-{{ label }}">
													{{ message }}
												</p>
											{% endfor %}
										</div>
									{% endfor %}

									{% if event.date >= date() %}
										<div class="col-12 col-md-4">
											<a class="btn w-100" href="{{ path('app_event_edit', { id: event.id }) }}">Modifier</a>
										</div>

										<div class="col-12 col-md-4">
											<div class="flex-fill">
												{{include("event/_delete_form.html.twig")}}
											</div>
										</div>
									{% endif %}
								</div>
							</div>
						</div>

					</div>

					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-5">
							<a class="btn" href="{{ path('app_event_page') }}">Evénements</a>
						</div>
					</div>

				</div>

			</div>

		</div>
	</section>
</main>{% endblock %}
